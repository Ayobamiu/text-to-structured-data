# Database Configuration
# Optional: set to false if your DB hostname has no IPv4 A record (rare)
# DATABASE_FORCE_IPV4=false
# Optional: force TLS certificate strictness (default: strict for direct DB, relaxed for Supabase pooler)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=batch_processor
DB_USER=postgres
DB_PASSWORD=password

# Queue isolation (run migration first — see ai/migrations/add_queue_shard_to_file_processing_queue.js).
# When multiple workers share one DATABASE_URL (e.g. Railway worker + local worker on the same cloud DB),
# another deployment can dequeue rows as soon as they are inserted. Set the SAME non-default QUEUE_SHARD
# on ai-api and ai-worker for each environment (e.g. production). For local-only testing against that DB,
# use e.g. QUEUE_SHARD=local so cloud workers (default "default") do not consume your queue rows.
# QUEUE_SHARD=default

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# PaddleOCR extraction service (extract-paddle/, port 5002 locally)
PADDLEOCR_FLASK_URL=http://localhost:5002
# Optional token if extract-paddle enforces PADDLEOCR_API_TOKEN
# PADDLEOCR_API_TOKEN=

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# ExtendAI (document OCR / parse — used by the public demo)
EXTEND_API_KEY=your_extend_api_key_here
# EXTEND_API_VERSION=2025-04-21
# EXTEND_API_BASE=https://api.extend.ai

# Qwen (Alibaba Cloud DashScope) Configuration
# Use DASHSCOPE_API_KEY (recommended) or QWEN_API_KEY
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Optional: Override base URL (defaults to Singapore region)
# For China (Beijing) region, use: https://dashscope.aliyuncs.com/compatible-mode/v1
# For Singapore region (default): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Groq Configuration (for lightweight AI operations like job name generation)
GROQ_API_KEY=your_groq_api_key_here

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
S3_BUCKET_NAME=document-extractor-files
CLOUD_STORAGE_ENABLED=true

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d
API_KEY=your-api-key-for-programmatic-access

# File Storage Configuration
FILE_RETENTION_DAYS=7
UPLOAD_DIR=uploads

# Server Configuration
PORT=3000

# When running ai-api and ai-worker on the same machine, give the worker a
# different port than PORT (Railway overrides PORT per service; locally both
# processes read one .env, so omitting this reproduced EADDRINUSE on 3000).
WORKER_HEALTH_PORT=8080

# Public demo (coreextract.app drop zone)
# Jobs are created under a dedicated org (auto-created slug core-extract-demo).
# Optional overrides:
# DEMO_ORGANIZATION_ID=
# DEMO_USER_ID=
# Public URL of the web app — used in emailed Excel download links
DEMO_APP_URL=http://localhost:3001
DEMO_NOTIFY_EMAIL=hello@coreextract.app
DEMO_FROM_EMAIL=Core Extract <hello@coreextract.app>
# Required to email the visitor a download link (otherwise the send fails)
# RESEND_API_KEY=

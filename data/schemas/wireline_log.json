              },
              "rmf_temp_f": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Temperature for Rmf, °F."
              },
              "rmc_ohmm": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Rmc (mud cake resistivity), ohm-m."
              },
              "rmc_temp_f": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Temperature for Rmc, °F."
              },
              "rm_at_bht_ohmm": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Rm @ BHT / Rm @ MRT value, ohm-m."
              },
              "max_recorded_temp_f": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"

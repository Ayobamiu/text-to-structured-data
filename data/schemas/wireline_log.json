{
  "description": "You extract the HEADING of oil and gas wireline (electric / geophysical) well logs — the title block, remarks, casing and bore hole records, and curve track headers. The body of the log is continuous curves on a depth scale: do NOT transcribe curve values, and do NOT invent lithology from curve shapes. RULES: (1) The title block is often printed sideways; OCR may return its lines in an odd order. Pair each label with its value by meaning (DATE, RUN NO., DEPTH—DRILLER…). (2) Many logs print the heading again at the bottom, or a REPEAT PASS with its own track header. Extract each fact once. (3) Values with a temperature, e.g. 'Rm @ MRT 1.5 @ 107.6°F', split into the resistivity and the temperature fields. (4) Leave a field null when the log does not print it. Never take the API number, well name or operator from the filename.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_metadata",
    "well_identification",
    "elevations",
    "log_runs",
    "casing_record",
    "borehole_record",
    "curves",
    "formation_tops",
    "hole_volume_summary",
    "remarks",
    "extraction_metadata"
  ],
  "properties": {
    "document_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_subtype",
        "report_title",
        "has_repeat_section",
        "drilling_contractor",
        "page_number",
        "total_pages"
      ],
      "properties": {
        "document_subtype": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "electric_log",
                "induction_log",
                "combo_log",
                "porosity_log",
                "gamma_ray_neutron_log",
                "sonic_log",
                "cement_bond_log",
                "other_wireline_log"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "combo_log = one print combining resistivity with porosity/gamma tools (e.g. induction + neutron + density). electric_log = SP + normal/lateral resistivity, typical pre-1960s."
        },
        "report_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Main title as printed."
        },
        "has_repeat_section": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "True when a REPEAT PASS / repeat section is printed."
        },
        "drilling_contractor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Drilling contractor / rig line, e.g. 'MENDENHALL DRILLING RIG #3'."
        },
        "page_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Printed page number, if any."
        },
        "total_pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Printed total pages, if any."
        }
      }
    },
    "well_identification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_company",
        "well_name",
        "lease_name",
        "well_number",
        "api_number",
        "permit_number",
        "field",
        "county",
        "state",
        "country",
        "section",
        "township",
        "range",
        "location_description",
        "latitude_dd",
        "longitude_dd",
        "coordinate_datum"
      ],
      "properties": {
        "operator_company": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "COMPANY line of the log heading — the operator the log was run for, e.g. 'LUKE OIL COMPANY', 'GONSETT PETROLEUM COMPANY'. NOT the logging company (Schlumberger, Birdwell, RECON…), which goes in log_runs.logging_company."
        },
        "well_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "WELL line as written, including lease and number, e.g. 'DEERE No. 7A', 'DAILEY #3-A'."
        },
        "lease_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lease part of the well name without the number, e.g. 'DEERE', 'DAILEY'. Null if the name is not clearly lease + number."
        },
        "well_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number part of the well name, e.g. '7A', '3-A'."
        },
        "api_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "API well number as printed, e.g. '037-29530', '35-037-29530'. Older logs (pre-1970s) usually have none — leave null rather than taking a number from the filename."
        },
        "permit_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "State permit / file number where printed (also handwritten file stamps like 'CD 15253'). Null if none."
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "FIELD line, e.g. 'DUTCHER (ATOKA)', 'E. CUSHING'. 'WILDCAT' is a valid value."
        },
        "county": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "COUNTY / PARISH as written."
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "STATE as written, e.g. 'OKLAHOMA'."
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Country if printed, else null."
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Public Land Survey section, e.g. '23'."
        },
        "township": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Township with direction, e.g. '16N'."
        },
        "range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Range with direction, e.g. '8E'."
        },
        "location_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Footage call or location text as written, e.g. '1157\\' FNL & 700\\' FEL', 'SURF: SAME'."
        },
        "latitude_dd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Latitude in decimal degrees if printed on the log (positive north)."
        },
        "longitude_dd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Longitude in decimal degrees if printed (NEGATIVE for west, e.g. '96.4251 degW' → -96.4251)."
        },
        "coordinate_datum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Datum printed with the coordinates, e.g. 'NAD27'. Null if not printed."
        }
      },
      "description": "Well identity from the log heading (the title block, often printed sideways)."
    },
    "elevations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permanent_datum",
        "permanent_datum_elevation_ft",
        "log_measured_from",
        "log_measured_from_ft_above_pd",
        "drilling_measured_from",
        "kelly_bushing_ft",
        "derrick_floor_ft",
        "ground_level_ft"
      ],
      "properties": {
        "permanent_datum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "PERMANENT DATUM as written, usually 'GROUND LEVEL' or 'GL'."
        },
        "permanent_datum_elevation_ft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Elevation printed beside the permanent datum, feet."
        },
        "log_measured_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "LOG MEASURED FROM, e.g. 'KELLY BUSHING', 'K.B.', 'DERRICK FLOOR'."
        },
        "log_measured_from_ft_above_pd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Distance above the permanent datum for the log zero, e.g. '13 ft above PD' or '7\\' A.G.L.' → 7."
        },
        "drilling_measured_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "DRILLING MEASURED FROM, e.g. 'KELLY BUSHING', 'SAME'."
        },
        "kelly_bushing_ft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Elevation K.B. (or KB) in feet."
        },
        "derrick_floor_ft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Elevation D.F. in feet. 'N/A' → null."
        },
        "ground_level_ft": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Elevation G.L. in feet."
        }
      },
      "description": "Elevation block of the heading."
    },
    "log_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logging_company",
          "log_title",
          "log_types",
          "run_number",
          "log_date",
          "depth_driller_ft",
          "depth_logger_ft",
          "bottom_logged_interval_ft",
          "top_logged_interval_ft",
          "logged_interval_length_ft",
          "casing_driller_size_in",
          "casing_driller_depth_ft",
          "casing_logger_depth_ft",
          "bit_size_in",
          "mud",
          "time_circulation_stopped",
          "time_logger_on_bottom",
          "unit_number",
          "unit_location",
          "recorded_by",
          "witnessed_by",
          "other_services",
          "source_pages"
        ],
        "properties": {
          "logging_company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Wireline service company whose header this is, e.g. 'RECON PETROTECHNOLOGIES INC.', 'BIRDWELL', 'SCHLUMBERGER'."
          },
          "log_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Log name(s) printed in the title block, verbatim, joined with ' / ', e.g. 'DUAL INDUCTION - SP / COMPENSATED NEUTRON / LITHOLOGY DENSITY / GAMMA - MICROLOG', 'ELECTRIC LOG'."
          },
          "log_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "electric",
                "induction",
                "dual_induction",
                "laterolog",
                "spontaneous_potential",
                "resistivity_normal",
                "resistivity_lateral",
                "gamma_ray",
                "neutron",
                "density",
                "lithology_density",
                "microlog",
                "sonic",
                "caliper",
                "temperature",
                "cement_bond",
                "dipmeter",
                "other"
              ]
            },
            "description": "Normalised log types present in the title block and track headers. 'TYPE OF LOG: ELEC' → electric."
          },
          "run_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "RUN NO. as written, e.g. 'ONE', '1'."
          },
          "log_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "DATE of the log run, ISO 8601 (YYYY-MM-DD). '4-18-58' → '1958-04-18'. This is when the log was run, NOT a completion date."
          },
          "depth_driller_ft": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "DEPTH—DRILLER / TD DRILLER, feet."
          },
          "depth_logger_ft": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "DEPTH—LOGGER / TD LOGGER (or 'TD RECON' etc.), feet."
          },
          "bottom_logged_interval_ft": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "BTM LOG INTERVAL / BOT LOGGED INTERVAL, feet."
          },
          "top_logged_interval_ft": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "TOP LOG INTERVAL / TOP LOGGED INTERVAL, feet. Only when printed as a depth — see logged_interval_length_ft."
          },
          "logged_interval_length_ft": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the heading prints 'LOGGED INTERVAL' as a single footage (e.g. '498'), record it here, not as a top depth."
          },
          "casing_driller_size_in": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "CASING—DRILLER size in inches ('8 5/8' → 8.625)."
          },
          "casing_driller_depth_ft": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "CASING—DRILLER depth, feet (the '@ 633' part)."
          },
          "casing_logger_depth_ft": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "CASING—LOGGER / CASING DEPTH RECON depth, feet."
          },
          "bit_size_in": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "BIT SIZE in inches ('7 7/8' → 7.875)."
          },
          "mud": {
